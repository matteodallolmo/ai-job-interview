# Copy to .env and fill in your own credentials.
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them into the client bundle at build time — see the security note
# in the README before pointing these at anything you care about.

# OpenAI — drives the interviewer, the report grading, the coach chat, and
# the text-embedding-3-small embeddings used for problem retrieval.
REACT_APP_OPENAI_API_KEY=

# Pinecone — index "leetcode-problems", namespace "version-1".
# See "Provisioning the Pinecone index" in the README for the expected schema.
REACT_APP_LINK_PINECONE_KEY=

# Supabase — anon key for the project referenced in src/App.js.
REACT_APP_SUPABASE_API_KEY=

# Judge0 via RapidAPI — remote code execution for the in-browser IDE.
REACT_APP_RAPID_API_URL=https://judge0-ce.p.rapidapi.com/submissions
REACT_APP_RAPID_API_HOST=judge0-ce.p.rapidapi.com
REACT_APP_RAPID_API_KEY=
